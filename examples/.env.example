# Optional process environment; no real credentials belong here.
# npm scripts do NOT auto-load .env. Prefer the local API-Key panel.
QQBOT_PROFILE_NAME=qqbot-demo
# QQBOT_PROFILE_DIR=/absolute/private/profile
# QQBOT_DSH_BIN=/absolute/path/to/dsh
# OPENAI_API_KEY=
# SILICONFLOW_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# DEEPSEEK_API_KEY=
# XIANGXIN_API_KEY=
# OPENCODE_GO_API_KEY=
# QQBOT_APPID=
# QQBOT_SECRET=
# Optional (defaults below are conservative):
QQBOT_DIARY=off
QQBOT_DIARY_PUBLISH=off
QQBOT_VECTOR=off
QQBOT_MEMORY_WRITE=off
# Cross-provider fallback can forward chat context and incur charges; opt-in only.
QQBOT_MODEL_FAILOVER=off
