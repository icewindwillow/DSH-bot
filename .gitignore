# Repository root is an explicit publication allowlist.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/package.json
!/package-lock.json
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/docs/
!/examples/
!/scripts/
!/tests/
!/patch-qqbot.mjs
!/qqbot-patches/
!/bot-config-panel/
!/plugins/
# Never publish machine state, even inside allowed source directories.
**/node_modules/
**/.git/
.env
.env.*
!.env.example
.bot-secrets.json
.control-token
*.log
*.jsonl
*.db
*.db-*
*.sqlite*
*.bak
*.bak-*
*.tmp
*.tgz
.DS_Store
**/.qqbot-patch-backups/
**/who/
**/sessions/
**/credentials/
**/media/
**/images/
**/cache/
